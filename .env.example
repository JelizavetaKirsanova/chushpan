# Личные настройки. Скопируйте в .env (он не попадает в Git) и заполните:
#   При существующем .env добавляйте только нужные строки; не перезаписывайте файл.

# Gemini Developer API: ключ проекта Free tier из https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# После проверки Free tier, отсутствия Cloud Billing и условий своего региона:
# https://ai.google.dev/gemini-api/terms
# JARVIS_GEMINI__FREE_TIER_CONFIRMED=true
JARVIS_LLM__PROVIDER=gemini
# Локальный режим: JARVIS_LLM__PROVIDER=ollama

# Русский: ru-RU. Также поддерживаются pt-BR, pt-PT, en-GB и en-US.
JARVIS_LANGUAGE=ru-RU
JARVIS_WAKEWORD__PHRASE=эй чушпан
JARVIS_ASSISTANT_NAME=Чушпан

JARVIS_OWNER_NAME= "Лиза"
JARVIS_OWNER_GENDER=neutral         # female — женщина, male — мужчина, neutral — без указания пола
# Пусто = обращение по умолчанию для выбранного языка и пола
JARVIS_OWNER_TITLE=

# «Город, регион, страна» — для погоды и часового пояса
JARVIS_CITY=
# Необязательно: точные координаты позволяют обойтись без поиска города
# JARVIS_LATITUDE=59.44
# JARVIS_LONGITUDE=24.75
# JARVIS_TIMEZONE=Europe/Tallinn

# Дополнительно: любой параметр config.yaml, вложенные секции разделяются «__»
# JARVIS_LOG_LEVEL=DEBUG
# JARVIS_PERSONA__FILE=personality.md  # файл характера; изменения действуют со следующей реплики
# JARVIS_PERSONA__STYLE=              # необязательные дополнения к характеру
# JARVIS_LLM__MODEL=qwen3.5:9b-q4_K_M
# JARVIS_LLM__NUM_CTX=16384       # личность + инструменты + история разговора
# JARVIS_TTS__ENGINE=silero
# JARVIS_TTS__SILERO_SPEAKER=eugene # eugene | aidar — мужские голоса
# JARVIS_TTS__VOICE=ru_RU-dmitri-medium # только для ENGINE=piper
# JARVIS_AUDIO__BARGE_IN=true       # прерывание голосом; с эхоподавлением наушники не нужны
# JARVIS_WAKEWORD__THRESHOLD=0.5    # ниже = чувствительнее; проверка: wake-test
# JARVIS_WAKEWORD__ENABLED=false    # слушать постоянно, без фразы «эй чушпан»
# JARVIS_MEDIA__DUCK_TO=0.2         # громкость Spotify во время разговора; 0 — не приглушать
# YouTube Music через установленное Safari Web App. Громкость сама не меняется.
# JARVIS_MEDIA__PROVIDER=youtube_music   # spotify — переключиться обратно
# JARVIS_MEDIA__YOUTUBE_MUSIC__ENABLED=true
# JARVIS_MEDIA__YOUTUBE_MUSIC__APP_PATH=~/Applications/Music.app
# JARVIS_MEDIA__YOUTUBE_MUSIC__BUNDLE_ID= # пусто: найти Safari Web App по манифесту
# JARVIS_MEDIA__YOUTUBE_MUSIC__AUTH_FILE=private/ytmusic/browser.json  # необязательно
# Основной плейлист и сценарии назначаются голосом и сохраняются в базе памяти.
GEMINI_API_KEY=
JARVIS_LLM__PROVIDER=gemini
JARVIS_GEMINI__FREE_TIER_CONFIRMED=true

# YouTube Data API v3: separate restricted key; never reuse the Gemini key implicitly.
YOUTUBE_API_KEY=
# Public/unlisted ordinary YouTube playlist (not Watch Later/history, not YouTube Music).
YOUTUBE_SLEEP_PLAYLIST_URL=
# Playlist metadata cache, seconds (60..2592000); default 6 hours.
YOUTUBE_CACHE_TTL=21600
