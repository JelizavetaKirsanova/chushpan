#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 0
python="$root/.venv/bin/python"
[ -x "$python" ] || python=python3
"$python" "$root/scripts/git_sync.py" push || {
  echo 'Local commit saved. Push pending; inspect scripts/git_sync.py status.' >&2
}
# A failed push must never turn a successful local commit into an apparent failure.
exit 0
